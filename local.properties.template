# Basara 4 Android - Project Properties
# This file tells Gradle where the Android SDK and NDK are located

# Android SDK path (configure on your machine)
# sdk.dir=/path/to/Android/Sdk

# Android NDK path (configure on your machine)
# ndk.dir=/path/to/Android/Sdk/ndk/26.3.11579264

# CMake path (usually comes with NDK)
# cmake.dir=/path/to/Android/Sdk/cmake/3.22.1

# Gradle settings
org.gradle.jvmargs=-Xmx4g -Xms256m
android.useAndroidX=true
android.enableJetifier=true
android.nonTransitiveRClass=true