+  bool compare_exchange_strong(T& expected, T desired) noexcept {
+    return std::atomic<T>(*ptr).compare_exchange_strong(expected, desired);
+  }
+  // 4-argument overload (used by WritePriorityMutex.h)
+  bool compare_exchange_strong(T& expected, T desired,
+      std::memory_order success, std::memory_order failure) noexcept {
+    return std::atomic<T>(*ptr).compare_exchange_strong(expected, desired, success, failure);
+  }
+  T fetch_add(T arg, std::memory_order mo = std::memory_order_seq_cst) noexcept {
+    return std::atomic<T>(*ptr).fetch_add(arg, mo);
+  }
+  T fetch_sub(T arg, std::memory_order mo = std::memory_order_seq_cst) noexcept {
+    return std::atomic<T>(*ptr).fetch_sub(arg, mo);
+  }
+  T operator=(T desired) noexcept { store(desired); return desired; }
+};
+#define FEXSTD_AREF fex_atomic_ref
+#endif
+#else
+#ifndef FEXSTD_AREF
+#define FEXSTD_AREF FEXSTD_AREF
+#endif
+#endif
